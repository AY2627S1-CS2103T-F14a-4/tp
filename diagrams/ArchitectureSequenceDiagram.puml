@startuml
!include style.puml
skinparam ArrowFontStyle plain

Actor User as user USER_COLOR
Participant ":UI" as ui UI_COLOR
Participant ":Logic" as logic LOGIC_COLOR
Participant ":Model" as model MODEL_COLOR
Participant ":Storage" as storage STORAGE_COLOR

user -[USER_COLOR]> ui : confirm deletion ("Y")
activate ui UI_COLOR

ui -[UI_COLOR]> logic : execute confirmation
activate logic LOGIC_COLOR

logic -[LOGIC_COLOR]> model : prepare updated records
activate model MODEL_COLOR
model --[MODEL_COLOR]> logic : updated records
deactivate model
note over logic, model : Logic changes a temporary model;\nthe live model is still unchanged.

logic -[LOGIC_COLOR]> storage : save updated records
activate storage STORAGE_COLOR
storage --[STORAGE_COLOR]> logic : save completed
deactivate storage

logic -[LOGIC_COLOR]> model : publish saved state
activate model MODEL_COLOR
model --[MODEL_COLOR]> logic
deactivate model

logic --[LOGIC_COLOR]> ui : successful result
deactivate logic
ui --[UI_COLOR]> user : deletion confirmed
deactivate ui
@enduml
