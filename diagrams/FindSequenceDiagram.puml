@startuml
!include style.puml
skinparam ArrowFontStyle plain

box UI UI_COLOR_T1
participant ":MainWindow" as MainWindow UI_COLOR
participant ":PersonListPanel" as PersonListPanel UI_COLOR
end box

box Logic LOGIC_COLOR_T1
participant ":LogicManager" as Logic LOGIC_COLOR
participant ":ClientBookParser" as Parser LOGIC_COLOR
participant ":FindCommandParser" as FindParser LOGIC_COLOR
participant "command:FindCommand" as Command LOGIC_COLOR
end box

box Model MODEL_COLOR_T1
participant "predicate:PersonMatchesFiltersPredicate" as Predicate MODEL_COLOR
participant "model:Model" as Model MODEL_COLOR
participant "filteredPersons:FilteredList<Person>" as FilteredList MODEL_COLOR
end box

[-> MainWindow : executeCommand("find Alex r/client t/priority k/retirement")
activate MainWindow
MainWindow -> Logic : execute(commandText)
activate Logic
Logic -> Parser : parseCommand(commandText)
activate Parser
Parser -> FindParser : parse(arguments)
activate FindParser
note right of FindParser
Tokenize the optional r/, t/ and k/ filters.
Reject duplicate prefixes and validate supplied values.
Require at least one name, relationship, tag or detail filter.
end note
create Predicate
FindParser -> Predicate : new PersonMatchesFiltersPredicate(\nnameKeywords, relationship, tagKeywords, detailKeywords)
create Command
FindParser -> Command : new FindCommand(predicate)
FindParser --> Parser : command
deactivate FindParser
Parser --> Logic : command
deactivate Parser
Logic -> Command : execute(model)
activate Command
Command -> Model : updateFilteredPersonList(predicate)
activate Model
Model -> FilteredList : setPredicate(predicate)
loop for each source person
    FilteredList -> Predicate : test(person)
    note right of Predicate
    Names: any keyword (OR)
    Relationship: exact match
    Tags: any keyword (OR)
    Details: any keyword across preferences, financial
    information, notes, and follow-up text/date (OR)
    Supplied filter types: all must match (AND)
    end note
    Predicate --> FilteredList : matches
end
FilteredList --> Model
deactivate Model
Command -> Model : getFilteredPersonList()
Model --> Command : matchingPersons
Command --> Logic : CommandResult(matchCount, selectFirstResult=true)
deactivate Command
Logic --> MainWindow : commandResult
deactivate Logic
MainWindow -> PersonListPanel : selectFirstPerson()
activate PersonListPanel
PersonListPanel -> PersonListPanel : select(0)
PersonListPanel -> PersonListPanel : scrollTo(0)
PersonListPanel --> MainWindow
deactivate PersonListPanel
MainWindow -> MainWindow : enable find-result navigation\nif a person is selected
[<-- MainWindow : commandResult
deactivate MainWindow
@enduml
