@startuml
!include style.puml
skinparam ArrowFontStyle plain

box Logic LOGIC_COLOR_T1
participant ":LogicManager" as LogicManager LOGIC_COLOR
participant ":ClientBookParser" as ClientBookParser LOGIC_COLOR
participant ":EditCommandParser" as EditCommandParser LOGIC_COLOR
participant "e:EditCommand" as EditCommand LOGIC_COLOR
participant "r:CommandResult" as CommandResult LOGIC_COLOR
end box

box Model MODEL_COLOR_T1
participant "m:Model" as Model MODEL_COLOR
end box

[-> LogicManager : execute("edit 1 n/Alex Tan")
activate LogicManager

LogicManager -> ClientBookParser : parseCommand(commandText)
activate ClientBookParser

create EditCommandParser
ClientBookParser -> EditCommandParser : new EditCommandParser()
activate EditCommandParser

EditCommandParser --> ClientBookParser
deactivate EditCommandParser

ClientBookParser -> EditCommandParser : parse(arguments)
activate EditCommandParser

create EditCommand
EditCommandParser -> EditCommand : new EditCommand(index, editPersonDescriptor)
activate EditCommand

EditCommand --> EditCommandParser : e: EditCommand
deactivate EditCommand

EditCommandParser --> ClientBookParser : e
deactivate EditCommandParser
' Hidden arrow positions the destroy marker below the activation bar.
EditCommandParser -[hidden]-> ClientBookParser
destroy EditCommandParser

ClientBookParser --> LogicManager : e
deactivate ClientBookParser

LogicManager -> EditCommand : execute(m)
activate EditCommand

EditCommand -> Model : getClientBook().getPersonList()
activate Model

Model --> EditCommand : all persons
deactivate Model

EditCommand -> Model : getFilteredPersonList()
activate Model

Model --> EditCommand : visible persons
deactivate Model

EditCommand -> Model : setPerson(personToEdit, editedPerson)
activate Model

Model --> EditCommand
deactivate Model

create CommandResult
EditCommand -> CommandResult : new CommandResult(message)
activate CommandResult

CommandResult --> EditCommand
deactivate CommandResult

EditCommand --> LogicManager : r: CommandResult
deactivate EditCommand

[<-- LogicManager : r
deactivate LogicManager
@enduml
