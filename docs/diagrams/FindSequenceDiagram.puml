@startuml
!include style.puml
skinparam ArrowFontStyle plain

box Logic LOGIC_COLOR_T1
participant ":LogicManager" as Logic LOGIC_COLOR
participant ":Parser" as Parser LOGIC_COLOR
participant "command:FindCommand" as Command LOGIC_COLOR
end box

box Model MODEL_COLOR_T1
participant ":Model" as Model MODEL_COLOR
participant "predicate:FilterPredicate" as Predicate MODEL_COLOR
end box

[-> Logic : execute("find Alex r/client t/priority k/retirement")
activate Logic
Logic -> Parser : parseCommand(...)
activate Parser
note right of Parser : Validate the supplied filters and\nbuild the combined predicate.
Parser --> Logic : command
deactivate Parser

Logic -> Command : execute(model)
activate Command
Command -> Model : apply filter predicate
activate Model
loop for each person
    Model -> Predicate : test(person)
    Predicate --> Model : matches
end
note right of Predicate : Match any value within a filter,\nbut match every supplied filter.
deactivate Model
Command --> Logic : result requesting first-match selection
deactivate Command
note right of Logic : The UI selects the first match, or clears\nthe selection when there are no matches.
[<-- Logic : command result
deactivate Logic
@enduml
