@startuml
!include style.puml
skinparam ArrowFontStyle plain

box Model MODEL_COLOR_T1
participant ":Model" as Model MODEL_COLOR
participant ":VersionedClientBook" as VersionedClientBook MODEL_COLOR
end box

[-> Model : undoClientBook()
activate Model

Model -> VersionedClientBook : undo()
activate VersionedClientBook

VersionedClientBook -> VersionedClientBook :resetData(ReadOnlyClientBook)
VersionedClientBook --> Model :
deactivate VersionedClientBook

[<-- Model
deactivate Model

@enduml
