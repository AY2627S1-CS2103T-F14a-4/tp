@startuml
!include style.puml
skinparam ArrowFontStyle plain

box Logic LOGIC_COLOR_T1
participant ":LogicManager" as Logic LOGIC_COLOR
participant ":ClientBookParser" as Parser LOGIC_COLOR
participant ":TagCommandParser" as TagParser LOGIC_COLOR
participant "command:TagCommand" as Command LOGIC_COLOR
end box

box Model MODEL_COLOR_T1
participant "live:Model" as Live MODEL_COLOR
participant "temporary:ModelManager" as Temp MODEL_COLOR
end box

box Storage STORAGE_COLOR_T1
participant ":Storage" as Storage STORAGE_COLOR
end box

[-> Logic : execute("tag 1 priority referral")
activate Logic
Logic -> Parser : parseCommand(commandText)
activate Parser
Parser -> TagParser : parse(arguments)
activate TagParser
note right of TagParser
Parse the displayed-list index and validate one or more tags.
The parsed set removes duplicate supplied tags.
end note
create Command
TagParser -> Command : new TagCommand(index, tags)
TagParser --> Parser : command
deactivate TagParser
Parser --> Logic : command
deactivate Parser
Logic -> Live : getClientBook(), getUserPrefs(),\ngetFilteredPersonPredicate(), getFilteredPersonComparator()
Live --> Logic : data, preferences, predicate, comparator
create Temp
Logic -> Temp : new ModelManager(data, preferences)
Logic -> Temp : updateFilteredPersonList(predicate, comparator)
Logic -> Command : execute(temporary, storage)
activate Command
Command -> Temp : getClientBook().getPersonList(),\ngetFilteredPersonList()
Temp --> Command : complete and visible persons
note right of Command : Resolve the original index;\nreject a hidden person.
Command -> Command : compare existing and supplied tags\ncase-insensitively
alt at least one supplied tag already exists
    Command --> Logic : CommandException(duplicate tags)
    deactivate Command
    [<-- Logic : error message
else all supplied tags are new
    Command -> Command : updated = person.withTags(existing + supplied)
    Command -> Temp : setPerson(person, updated)
    Command --> Logic : CommandResult
    deactivate Command
    Logic -> Temp : getClientBook()
    Temp --> Logic : updated client book
    Logic -> Storage : saveClientBook(updated client book)
    Storage --> Logic : save completed
    Logic -> Live : setClientBook(updated client book)
    Logic -> Live : updateFilteredPersonList(predicate, comparator)
    [<-- Logic : CommandResult
end
deactivate Logic
@enduml
